rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{categoryId} {
      allow get, list: if true;
    }

    match /config/{docId} {
      allow get: if docId == 'app';
    }

    match /tools/{slug} {
      allow get, list: if resource.data.published == true;

      match /updates/{updateId} {
        allow get, list: if true;
      }
    }

    match /bundles/{slug} {
      allow get, list: if resource.data.published == true;
    }
  }
}
