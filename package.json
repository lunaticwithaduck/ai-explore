{
  "name": "ai-explore",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "scripts/dev.sh",
    "emulators": "scripts/emulators.sh",
    "seed": "scripts/seed.sh",
    "lint": "biome check . && node scripts/lint-conventions.cjs",
    "lint:fix": "biome check --write .",
    "lint:conventions": "node scripts/lint-conventions.cjs",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rules": "scripts/test-rules.sh",
    "test:e2e": "scripts/test-e2e.sh",
    "gate": "scripts/gate.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "firebase-tools": "15.34.0",
    "husky": "9.1.7",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
